{
  "name": "pathways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3005",
    "build": "next build --turbopack",
    "start": "next start -p 3005",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ingest:csc:actions": "uv run --project ingest python ingest/csc_checklist.py",
    "ingest:csc:communities": "uv run --project ingest python ingest/csc_communities.py",
    "ingest:cec:hia": "uv run --project ingest python ingest/cec_hia.py",
    "ingest:cec:designations": "uv run --project ingest python ingest/cec_designations.py",
    "ingest:cec:completions": "uv run --project ingest python ingest/cec_completions.py",
    "ingest:cec:crosswalk": "uv run --project ingest python ingest/cec_crosswalk.py"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "maplibre-gl": "^6.10.0",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Open-source NY community climate dashboard tracking NYSDEC CSC + NYSERDA CEC programs.",
  "license": "AGPL-3.0-only"
}
