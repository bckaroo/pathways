{
  "name": "pathways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3005",
    "build": "next build --turbopack",
    "build:static": "node scripts/to-static-export.mjs apply && STATIC_EXPORT=1 next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "test:tree": "node --test tests/tree-layout.test.mjs",
    "export:apply": "node scripts/to-static-export.mjs apply",
    "export:revert": "node scripts/to-static-export.mjs revert",
    "snapshot:dump": "bash scripts/snapshot-db.sh dump",
    "snapshot:restore": "bash scripts/snapshot-db.sh restore",
    "vendor:maplibre": "node scripts/vendor-maplibre-worker.mjs",
    "postinstall": "node scripts/vendor-maplibre-worker.mjs",
    "smoke:map": "bash scripts/_python.sh scripts/smoke_map.py",
    "verify:ghg": "bash scripts/_python.sh scripts/verify_ghg_sources.py",
    "test:fallback": "bash scripts/_python.sh scripts/test_basemap_fallback.py",
    "verify:csc": "bash scripts/_python.sh scripts/verify_csc_actions.py",
    "validate:csc": "tsx scripts/validate-csc-rules.mjs",
    "audit:contrast": "bash scripts/_python.sh scripts/audit_contrast.py",
    "shot:theme": "bash scripts/_python.sh scripts/shot_theme.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ingest:csc:actions": "uv run --project ingest python ingest/csc_checklist.py",
    "ingest:csc:communities": "uv run --project ingest python ingest/csc_communities.py",
    "ingest:cec:hia": "uv run --project ingest python ingest/cec_hia.py",
    "ingest:cec:designations": "uv run --project ingest python ingest/cec_designations.py",
    "ingest:cec:completions": "uv run --project ingest python ingest/cec_completions.py",
    "ingest:cec:crosswalk": "uv run --project ingest python ingest/cec_crosswalk.py",
    "ingest:geocode": "uv run --project ingest python ingest/geocode.py"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "maplibre-gl": "^6.10.0",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Open-source NY community climate dashboard tracking NYSDEC CSC + NYSERDA CEC programs.",
  "license": "AGPL-3.0-only"
}
