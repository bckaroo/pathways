# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pathways
.env
.env.local
data/
ingest/.venv/
__pycache__/
*.pyc

# The env TEMPLATE must ship: README tells users to `cp .env.example .env`,
# and .gitignore's own `.env*` / `.env` patterns would otherwise exclude it,
# leaving a fresh clone unable to start. Negation has to come AFTER every
# pattern it needs to override — order matters in .gitignore.
!.env.example

# The data snapshot MUST ship: the Pages build restores it instead of re-scraping
# government sites from CI. `data/` above would otherwise exclude it, and the
# deploy would fail on a missing file. Generated by scripts/snapshot-db.sh.
!data/
data/*
!data/pathways-snapshot.sql.gz

# Ingestion scratch (raw downloads, caches) is never published.
ingest/data/

# Vendored MapLibre v6 worker (copied from node_modules by
# scripts/vendor-maplibre-worker.mjs, wired to `postinstall`).
# NOT committed: it is a verbatim third-party bundle that `npm install`
# regenerates, and 500 KB of minified upstream code does not belong in this
# repo's history. If you vendor by hand, run `npm run vendor:maplibre`.
# The file MUST be present at serve time or the map renders blank with no
# error — see scripts/smoke_map.py.
/public/maplibre/
