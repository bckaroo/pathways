# Pathways environment — copy to .env and adjust as needed.
# Postgres connection (matches docker-compose.yml defaults).
DATABASE_URL=postgresql://pathways:pathways@localhost:5433/pathways

# Dev server port. Pathways dev servers run in the 3000-3099 range; 3005 is
# the documented default (see README).
DEV_PORT=3005

# CSC portal base URL (NYSDEC Climate Smart Communities, TYPO3 CMS).
CSC_BASE_URL=https://climatesmart.ny.gov